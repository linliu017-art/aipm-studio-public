          <div
            class="detailBrandRow"
          >
            <button
              aria-label="新建对话"
              class="brand"
              type="button"
            >
              <span
                aria-hidden="true"
                class="brandIdentity"
              >
                <span
                  class="brandName"
                >
                  <div
                    data-slot="sidebar.brand.name"
                    style="display: contents;"
                  >
                    <span
                      class="localBuildBrand"
                    >
                      <span
                        class="localBuildTitle"
                      >
                        Nini Flow
                      </span>
                      <span
                        class="buildVersion"
                      >
                        1.2.3-rc.4-abc1234-dirty
                      </span>
                    </span>
                  </div>
                </span>
              </span>
            </button>
            <button
              aria-label="收起侧边栏"
              class="detailToggle"
              type="button"
            >
              <svg
                aria-hidden="true"
                data-content="88020f34"
                fill="none"
                height="17"
                stroke-width="1"
                viewBox="0 0 16 16"
                width="17"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
          </div>
          <strong>
            Agent 对话
          </strong>
          <span>
            继续历史对话或开始新任务
          </span>
        </header>
        <button
          aria-label="新建对话"
          class="newSession"
          type="button"
        >
          <span
            class="newSessionContent"
          >
            <svg
              aria-hidden="true"
              data-content="2cd56dfd"
              fill="none"
              height="16"
              stroke-width="1"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
            <span>
              新建对话
            </span>
          </span>
        </button>
        <button
          aria-controls="aipm-quick-actions"
          aria-expanded="false"
          class="quickToggle"
          type="button"
        >
          <svg
            aria-hidden="true"
            data-content="827a63da"
            fill="none"
            height="16"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          />
          <span>
            快捷操作
          </span>
          <svg
            aria-hidden="true"
            class="quickChevron"
            data-content="2b5d7fd1"
            fill="none"
            height="14"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </section>
    </div>
  </div>
</div>
`;
