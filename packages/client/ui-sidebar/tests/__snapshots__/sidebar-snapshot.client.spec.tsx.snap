// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`sidebar shell snapshots > renders Windows caption controls in expanded and collapsed states > windows collapsed 1`] = `
<div
  data-slot="sidebar"
  style="display: contents;"
>
  <div
    class="root collapsed railIn quietBars"
    style=""
  >
    <div
      class="shellBody"
    >
      <aside
        aria-label="Global panels"
        class="rail"
      >
        <button
          aria-label="Open sidebar"
          class="brandToggle"
          type="button"
        >
          <span
            aria-hidden="true"
            class="brandMark"
          >
            <div
              data-slot="sidebar.brand.mark"
              style="display: contents;"
            >
              <svg
                aria-hidden="true"
                data-content="5633854c"
                fill="none"
                height="40"
                viewBox="0 0 48 48"
                width="40"
              />
            </div>
          </span>
          <svg
            aria-hidden="true"
            class="collapseGlyph"
            data-content="88020f34"
            fill="none"
            height="17"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="17"
            xmlns="http://www.w3.org/2000/svg"
          />
          <div
            data-slot="sidebar.toggle.badge"
            style="display: contents;"
          />
        </button>
        <button
          aria-current="page"
          aria-label="Back to Agent chat"
          class="railButton railButtonActive"
          type="button"
        >
          <svg
            aria-hidden="true"
            data-content="47b5e433"
            fill="none"
            height="18"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="18"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
        <nav
          aria-label="Global panels"
          class="panelList"
        >
          <button
            aria-label="Projects"
            class="railButton"
            type="button"
          >
            <div
              data-slot="sidebar.panellist"
              style="display: contents;"
            >
              <svg
                aria-hidden="true"
                data-content="964807f4"
                fill="none"
                height="18"
                stroke-width="1"
                viewBox="0 0 16 16"
                width="18"
                xmlns="http://www.w3.org/2000/svg"
              />
            </div>
          </button>
        </nav>
        <div
          class="railSpacer"
        />
        <div
          class="footerActions"
        >
          <div
            data-slot="sidebar.footer.action"
            style="display: contents;"
          />
        </div>
        <div
          class="settingsArea"
        >
          <div
            data-slot="sidebar.settings"
            style="display: contents;"
          />
        </div>
      </aside>
      <section
        aria-hidden="true"
        class="detail wide"
      >
        <header
          class="detailHeader"
        >
          <div
            class="detailBrandRow"
          >
            <button
              aria-label="New chat"
              class="brand"
              type="button"
            >
              <span
                aria-hidden="true"
                class="brandIdentity"
              >
                <span
                  class="brandName"
                >
                  <div
                    data-slot="sidebar.brand.name"
                    style="display: contents;"
                  >
                    <span
                      class="localBuildBrand"
                    >
                      <span
                        class="localBuildTitle"
                      >
                        Nini Flow
                      </span>
                      <span
                        class="buildVersion"
                      >
                        1.2.3-rc.4-abc1234-dirty
                      </span>
                    </span>
                  </div>
                </span>
              </span>
            </button>
            <button
              aria-label="Open sidebar"
              class="detailToggle"
              type="button"
            >
              <svg
                aria-hidden="true"
                data-content="88020f34"
                fill="none"
                height="17"
                stroke-width="1"
                viewBox="0 0 16 16"
                width="17"
                xmlns="http://www.w3.org/2000/svg"
              />
            </button>
          </div>
          <strong>
            Agent chat
          </strong>
          <span>
            Continue a conversation or start a new task
          </span>
        </header>
        <button
          aria-label="New chat"
          class="newSession"
          type="button"
        >
          <span
            class="newSessionContent"
          >
            <svg
              aria-hidden="true"
              data-content="2cd56dfd"
              fill="none"
              height="16"
              stroke-width="1"
              viewBox="0 0 16 16"
              width="16"
              xmlns="http://www.w3.org/2000/svg"
            />
            <span>
              New chat
            </span>
          </span>
        </button>
        <button
          aria-controls="aipm-quick-actions"
          aria-expanded="false"
          class="quickToggle"
          type="button"
        >
          <svg
            aria-hidden="true"
            data-content="827a63da"
            fill="none"
            height="16"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="16"
            xmlns="http://www.w3.org/2000/svg"
          />
          <span>
            Quick actions
          </span>
          <svg
            aria-hidden="true"
            class="quickChevron"
            data-content="2b5d7fd1"
            fill="none"
            height="14"
            stroke-width="1"
            viewBox="0 0 16 16"
            width="14"
            xmlns="http://www.w3.org/2000/svg"
          />
        </button>
        <div
          class="regionArea"
        >
          <div
            data-slot="sidebar.workspaces"
            style="display: contents;"
          />
        </div>
      </section>
    </div>
  </div>
</div>
`;

